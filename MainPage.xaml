<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Damelasnotas3000.MainPage"
             Title="Damelasnotas3000">

    <ScrollView>
        <VerticalStackLayout Padding="25"
                             Spacing="20">
            <!--<Label
                x:Name="DebugStatus"
                Text="MainPage.xaml cargado"
                FontSize="18"
                TextColor="Red" />-->
            
            <Label Text="Damelasnotas3000"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Convierte tu música en partituras"
                   FontSize="16"
                   HorizontalOptions="Center" />

            <Label x:Name="RecordingStatus"
                   Text="Listo para grabar o escoger audio"
                   FontSize="16"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="RecordButton"
                    Text="● Grabar audio"
                    Clicked="OnRecordClicked"
                    IsEnabled="True"
                    BackgroundColor="#D32F2F"
                    TextColor="White"
                    HeightRequest="60" />

            <Button x:Name="PickAudioButton"
                    Text="📂 Escoger audio WAV"
                    Clicked="OnPickAudioClicked"
                    HeightRequest="55" />

            <Button x:Name="StopButton"
                    Text="■ Detener grabación"
                    Clicked="OnStopClicked"
                    IsEnabled="False"
                    HeightRequest="55" />

            <Button x:Name="DiscardButton"
                    Text="✕ Quitar audio"
                    Clicked="OnDiscardClicked"
                    IsEnabled="False"
                    HeightRequest="55" />

            <Label x:Name="AudioFileStatus"
                   Text="No hay audio seleccionado"
                   FontSize="13"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label Text="Transcriptor que alimenta la partitura"
                   FontSize="16"
                   FontAttributes="Bold" />

            <Picker x:Name="TranscriptionEnginePicker"
                    Title="Motor de transcripción"
                    SelectedIndex="0">
                <Picker.Items>
                    <x:String>Magenta</x:String>
                    <x:String>Basic Pitch</x:String>
                </Picker.Items>
            </Picker>

            <Label Text="Por defecto se ejecuta solo el motor seleccionado. Activa la comparación para generar ambos MIDI; tarda más."
                   FontSize="12" />

            <HorizontalStackLayout Spacing="8"
                                   VerticalOptions="Center">
                <CheckBox x:Name="CompareEnginesCheckBox"
                          IsChecked="False" />
                <Label Text="Comparar ambos motores"
                       FontSize="14"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Ajustes opcionales de partitura"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Label Text="Indica el compás o tempo si conoces la referencia. En automático se usa el análisis; si el compás queda sin confirmar, elige aquí el compás conocido. El número de BPM corresponde a la unidad seleccionada."
                   FontSize="13" />

            <Picker x:Name="MeterOverridePicker"
                    Title="Compás: automático"
                    SelectedIndex="0">
                <Picker.Items>
                    <x:String>Automático</x:String>
                    <x:String>2/4</x:String>
                    <x:String>3/4</x:String>
                    <x:String>4/4</x:String>
                    <x:String>6/8</x:String>
                    <x:String>9/8</x:String>
                    <x:String>12/8</x:String>
                </Picker.Items>
            </Picker>

            <Entry x:Name="TempoOverrideEntry"
                   Placeholder="Tempo manual en BPM (opcional)"
                   Keyboard="Numeric"
                   MaxLength="6" />

            <Picker x:Name="TempoUnitPicker"
                    Title="Unidad del pulso: automática"
                    SelectedIndex="0">
                <Picker.Items>
                    <x:String>Automático</x:String>
                    <x:String>Negra</x:String>
                    <x:String>Corchea</x:String>
                    <x:String>Negra con puntillo</x:String>
                    <x:String>Blanca</x:String>
                </Picker.Items>
            </Picker>
            <Button x:Name="ConvertButton"
                    Text="Convertir a MIDI"
                    IsEnabled="False"
                    Clicked="OnConvertClicked"
                    HeightRequest="55" />

            <Label Text="Partitura"
                   FontSize="22"
                   FontAttributes="Bold" />


            <Label Text="Reproducción"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Label x:Name="PlaybackTimeLabel"
                   Text="00:00 / 00:00"
                   FontSize="15"
                   HorizontalOptions="Center" />

            <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="Center"
                        AlignItems="Center">
                <Button x:Name="RestartPlaybackButton"
                        Text="↺ Reiniciar"
                        Clicked="OnRestartPlaybackClicked"
                        IsEnabled="False"
                        WidthRequest="112"
                        HeightRequest="48"
                        Margin="4" />

                <Button x:Name="SeekBackButton"
                        Text="−10 s"
                        Clicked="OnSeekBackClicked"
                        IsEnabled="False"
                        WidthRequest="88"
                        HeightRequest="48"
                        Margin="4" />

                <Button x:Name="PlayButton"
                        Text="▶ Play"
                        Clicked="OnPlayClicked"
                        IsEnabled="False"
                        BackgroundColor="#2E7D32"
                        TextColor="White"
                        WidthRequest="100"
                        HeightRequest="48"
                        Margin="4" />

                <Button x:Name="PausePlaybackButton"
                        Text="Ⅱ Pausa"
                        Clicked="OnPausePlaybackClicked"
                        IsEnabled="False"
                        BackgroundColor="#424242"
                        TextColor="White"
                        WidthRequest="100"
                        HeightRequest="48"
                        Margin="4" />

                <Button x:Name="SeekForwardButton"
                        Text="+10 s"
                        Clicked="OnSeekForwardClicked"
                        IsEnabled="False"
                        WidthRequest="88"
                        HeightRequest="48"
                        Margin="4" />

                <Button x:Name="EndPlaybackButton"
                        Text="Fin ⏭"
                        Clicked="OnEndPlaybackClicked"
                        IsEnabled="False"
                        WidthRequest="88"
                        HeightRequest="48"
                        Margin="4" />
            </FlexLayout>


            <WebView
                x:Name="ScoreWebView"
                HeightRequest="600"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Navigated="ScoreWebView_Navigated"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

